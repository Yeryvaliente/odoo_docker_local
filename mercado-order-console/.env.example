# Consola de órdenes Mercado v1_6 — copiá este archivo a .env y completalo.
# .env está en el .gitignore: la API key NO se commitea.

# Odoo destino. El host tiene que estar en la allowlist de server/config.ts:
# esta consola CREA y EDITA órdenes, así que no se apunta a producción.
ODOO_URL=https://odoo-test.ecsdev.cubatelefono.com

# API key de Odoo del usuario con el que querés operar. Los controllers usan
# `auth="bearer"`, que es el de Odoo core y acepta una API key como token.
# Se genera en: avatar -> Mi perfil -> Seguridad de la cuenta -> Nueva clave API.
ODOO_API_KEY=

# Solo lectura, para poblar los desplegables (almacenes, coverages, recipients,
# productos). Si falta, la UI arranca igual pero sin desplegables.
DATABASE_URL=postgres://usuario:password@host:5432/odoo

# Puerto del servicio dentro del container (el compose lo publica en 127.0.0.1).
PORT=8900

# Comercial Progreso: de ahí salen los almacenes espejo del bloque esquina.
# 472 en Odoocker test, 44 en las locales, 425 en el server de contabilidad.
CP_COMPANY_ID=472

# Nombre del negocio que se EXCLUYE de los coverages de pymes: sus órdenes van
# por el bloque top-level, no por businesses[].
ESQUINA_BUSINESS_NAME=La Esquina Caliente
