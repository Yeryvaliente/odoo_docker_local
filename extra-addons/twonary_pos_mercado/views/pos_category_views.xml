<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_category_form_inherit" model="ir.ui.view">
        <field name="name">pos.category.form.inherit</field>
        <field name="model">pos.category</field>
        <field name="inherit_id" ref="point_of_sale.product_pos_category_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='sequence']" position="after">
                <group string="Note Requirements" name="note_requirements">
                    <field name="customer_note_required" 
                           widget="boolean_toggle" 
                           string="Require Customer Note"/>
                    <field name="internal_note_required" 
                           widget="boolean_toggle" 
                           string="Require Internal Note"
                           readonly="customer_note_required"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
