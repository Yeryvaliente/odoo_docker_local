# Variables de entorno para el entorno de desarrollo de Odoo

# Base de datos PostgreSQL
POSTGRES_DB=odoo_18
POSTGRES_USER=odoo
POSTGRES_PASSWORD=odoo

# Ngrok (opcional - para exponer Odoo a internet)
# Obtén tu token gratuito en https://ngrok.com
# NGROK_AUTH_TOKEN=tu_token_aqui

# PgAdmin (opcional)
PGADMIN_DEFAULT_EMAIL=admin@localhost.com
PGADMIN_DEFAULT_PASSWORD=admin